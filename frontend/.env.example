# URL of the LangGraph API server (the backend's `langgraph dev` server).
VITE_LANGGRAPH_API_URL=http://localhost:2024

# Graph/assistant IDs as registered in backend/langgraph.json.
# Defaults below match the backend as shipped, so these are optional.
VITE_LANGGRAPH_RETRIEVAL_ASSISTANT_ID=retrieval_graph
VITE_LANGGRAPH_INGESTION_ASSISTANT_ID=ingestion_graph

# NOTE: This is now a pure client-side SPA (no server/API routes), so there
# is no secure place to store a LangSmith API key here. If your LangGraph
# server requires auth (e.g. a hosted/production deployment), you'll need a
# small server-side proxy to attach that key -- do not put secret API keys
# in VITE_ variables, since anything prefixed VITE_ is bundled into the
# public JavaScript that ships to the browser.
