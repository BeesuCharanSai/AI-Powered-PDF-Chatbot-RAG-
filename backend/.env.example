# Groq API key (used for the chat model). Get one free, no card required,
# at https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio API key (used only for embeddings, since Groq has no
# embeddings endpoint). Get one free, no card required, at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign login/session tokens (auth.db + /auth/* routes).
# Set this to a long random string before deploying anywhere real --
# anyone with this value can forge valid session tokens.
AUTH_SECRET_KEY=dev-insecure-secret-change-me-before-deploying-anywhere-real

# Optional: LangSmith for tracing (recommended for development)
LANGCHAIN_TRACING_V2=true
# Optional: LangSmith API key to access deployed graph
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=ai-agent-pdf-chatbot
